{
  "name": "vehiclevault",
  "version": "1.0.16",
  "private": true,
  "description": "Self-hosted vehicle lifecycle, fueling, maintenance, and TCO platform with OCR and MCP server",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "node server/dist/index.js",
    "mcp": "node server/dist/mcp/stdio.js",
    "mcp:dev": "tsx server/src/mcp/stdio.ts",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sharp": "^0.35.5"
  }
}
