# ==============================================================================
# VehicleVault — Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust the variables for your self-hosted setup.

# Environment & Server
NODE_ENV=production
PORT=3001
DATA_DIR=./data

# Authentication & Security
# IMPORTANT: Generate two unique, secure 64-character random strings in production:
# Command: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# CORS Origin (Set to your external domain in production, e.g. https://vault.yourdomain.com)
CORS_ORIGIN=*

# Reverse Proxy / Single Sign-On (Authelia, Authentik, Pangolin, Cloudflare Access, Traefik)
# When set to 'true', VehicleVault accepts identity headers (Remote-Email, Remote-User, X-Forwarded-Email)
# Only enable this if VehicleVault is behind a secure reverse proxy and NOT directly exposed.
ENABLE_PROXY_AUTH=false

# Disable Authentication (Optional, for isolated home LAN setups only)
# DISABLE_AUTH=false

# ==============================================================================
# Optional Integrations (Can also be configured via Settings UI in VehicleVault)
# ==============================================================================

# AI Vision Receipt Scanning (Google Gemini or OpenAI Vision)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=sk-...

# Email & SMTP Notifications (for APK reminders and password resets)
# SMTP_HOST=smtp.mailprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notifications@yourdomain.com
# SMTP_PASS=your_smtp_app_password
# SMTP_FROM="VehicleVault <notifications@yourdomain.com>"
# SMTP_TO=admin@yourdomain.com

# Push Notifications (Ntfy, Gotify, Webhooks)
# NOTIFICATION_PROVIDER=none
# NOTIFICATION_NTFY_URL=https://ntfy.sh/your_private_channel
# NOTIFICATION_GOTIFY_URL=https://gotify.yourdomain.com
# NOTIFICATION_GOTIFY_TOKEN=your_gotify_client_token
