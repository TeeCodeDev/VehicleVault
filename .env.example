# VehicleVault Configuration
NODE_ENV=production
PORT=3001
DATA_DIR=./data

# Secrets (Generate strong 64-char random strings for production)
JWT_SECRET=super_secret_jwt_access_key_replace_with_random_string_32chars
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_replace_with_random_string_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# CORS (Set to your domain in production, e.g. https://vault.yourdomain.com)
CORS_ORIGIN=*

# Database (Leave commented for SQLite with WAL mode at $DATA_DIR/vehiclevault.db)
# DATABASE_URL=postgres://vehiclevault:vehiclevault_secure_pass@postgres:5432/vehiclevault

